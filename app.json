{
  "expo": {
    "name": "Music Downloader",
    "slug": "music-downloader",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0c0e0c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicdownloader.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Music Downloader needs access to save downloaded MP3 songs to your music library.",
        "NSPhotoLibraryAddUsageDescription": "Music Downloader needs permission to add downloaded 320 kbps MP3 files to your audio library."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0e0c"
      },
      "package": "com.musicdownloader.app",
      "permissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Grant permission to access media",
          "savePhotosPermission": "Grant permission to save audio files",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "dad084e2-2c40-42ec-b05a-e4ff568a1f04"
      }
    },
    "owner": "nikskumawat"
  }
}
